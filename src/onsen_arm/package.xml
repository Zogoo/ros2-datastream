<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onsen_arm</name>
  <version>1.0.0</version>
  <description>Arm description (URDF from spec), servo-coupling joint bridge, and the analytic-IK manipulation model for the onsen robot</description>
  <maintainer email="chtsogbadrakh@gmail.com">Onsen Robot</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>onsen_robot_state</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
